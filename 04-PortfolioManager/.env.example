# Model provider (DeepSeek via OpenAI-compatible API)
API_KEY=your-model-api-key

# Exa search
EXA_API_KEY=your-exa-api-key

# Zerodha Kite MCP: no API keys needed — auth happens in the browser.
# Run `python server.py` and chat with the team; the zerodha agent's `login`
# tool returns an authorization URL for you to sign in at.

# Optional: set to "false" to silence team debug output (default: true)
# AGNO_DEBUG=true
